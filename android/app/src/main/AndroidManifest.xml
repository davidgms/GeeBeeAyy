<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.geebeeayy.app">

    <!-- Downloading freely distributable homebrew from the built-in catalogue.
         Nothing else in the app makes a network request. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Feedback under a finger on the on-screen buttons. A normal
         permission: granted at install, no runtime prompt. Without it every
         vibrate call is silently refused, which would leave the Vibration
         setting looking like a dead switch. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- MANAGE_EXTERNAL_STORAGE is API 30+. minSdk is 26, and MainActivity
         asks for READ_EXTERNAL_STORAGE below R - a permission that was never
         declared, so the request was denied outright and the ROM browser
         listed nothing at all on API 26-29. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <application
        android:name=".GeeBeeAyyApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.GeeBeeAyy">
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/gba-rom" />
                <data android:mimeType="application/x-gba-rom" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>
    </application>
</manifest>
