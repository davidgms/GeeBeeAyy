<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.gbee.emulator">

    <!-- Two things, and only two. Downloading freely distributable homebrew
         from the built-in catalogue, and - only once the player switches it
         on - fetching box art for the ROM list. Neither happens on its own,
         and no game or artwork is ever shipped inside this APK. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Feedback under a finger on the on-screen buttons. A normal
         permission: granted at install, no runtime prompt. Without it every
         vibrate call is silently refused, which would leave the Vibration
         setting looking like a dead switch. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- No storage permission. ROM folders are document trees the player
         picks (SAF, persisted grants), battery saves live in app storage, and
         screenshots go through MediaStore - audit item B1. -->

    <application
        android:name=".GBeeApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:appCategory="game"
        android:isGame="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.GBee">
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/gba-rom" />
                <data android:mimeType="application/x-gba-rom" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>
    </application>
</manifest>
