<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and higher. Same rule as backup_rules.xml, for both the cloud
     backup and the device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="retroachievements.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="retroachievements.xml" />
    </device-transfer>
</data-extraction-rules>
